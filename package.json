{
  "name": "kids-drawing-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:games": "vitest run --config vitest.games.config.ts",
    "test:touch": "vitest run --config vitest.mobile.config.ts",
    "test:fast": "vitest run && vitest run --config vitest.games.config.ts && vitest run --config vitest.mobile.config.ts",
    "test:e2e": "playwright test",
    "mcp:playwright": "PLAYWRIGHT_BASE_URL=http://localhost:5173 npx @playwright/mcp@latest --headless=false",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc-mobile.js"
  },
  "overrides": {
    "ws": ">=8.20.1",
    "tar-fs": ">=2.1.4"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.12.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^24.1.0",
    "playwright": "^1.56.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^6.0.15",
    "vitest": "^3.2.4"
  }
}
